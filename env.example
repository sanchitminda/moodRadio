# ─── Navidrome (Subsonic API) ────────────────────────────────────────────────
# On Windows/Mac Docker Desktop, host.docker.internal points at your host machine.
# If Navidrome runs elsewhere, use its full URL, e.g. http://192.168.1.20:4533
NAVIDROME_URL=http://host.docker.internal:4533
NAVIDROME_USER=your_navidrome_username
NAVIDROME_PASS=your_navidrome_password

# ─── Local LLM (OpenAI-compatible /v1/chat/completions) ──────────────────────
# Ollama:    http://host.docker.internal:11434   (model e.g. llama3.2)
# LM Studio: http://host.docker.internal:1234     (model = whatever is loaded)
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=llama3.2
# Ollama/LM Studio ignore this, but it's sent as a Bearer token if your server needs one.
LLM_API_KEY=not-needed
# How JSON output is enforced:
#   json_schema  — LM Studio (required) and OpenAI
#   json_object  — Ollama / OpenAI
#   text         — no structured mode; rely on tolerant parsing (works everywhere)
# On a wrong choice the app auto-retries as text, but set it right to avoid the extra call.
LLM_JSON_MODE=json_schema

# ─── Moods (optional override) ───────────────────────────────────────────────
# Single source of truth for the whole app (prompt, DB, API, UI buttons).
# Format: slug:Label,slug2:Label2   — leave unset to use the built-in defaults:
#   happy, sad, romantic, driving, long_drive_slow, party, workout, chill,
#   focus, nostalgic, devotional
# Add/remove moods here, restart, and re-index to (re)score tracks for them.
# A slug without a matching .grad-<slug> CSS theme uses the default gradient.
# MOODS=happy:Happy,sad:Sad,romantic:Romantic,driving:Driving,long_drive_slow:Long Drive · Slow,party:Party,workout:Workout,chill:Chill,focus:Focus,nostalgic:Nostalgic,devotional:Devotional,heartbreak:Heartbreak,festive:Festive

# ─── Indexing / enrichment ───────────────────────────────────────────────────
INDEX_BATCH_SIZE=8
# LRCLIB asks clients to identify themselves. Put a contact/app string here.
LYRICS_USER_AGENT=mood-radio/1.0 (https://github.com/yourname/mood-radio)

# ─── Genre prediction (optional, CLAP zero-shot audio classification) ─────────
# Requires the image built with INSTALL_GENRE=true (docker-compose sets that).
# Predicts a genre from the audio itself — good for Bollywood/Hindi where tags
# are missing or wrong. First run downloads ~1.7GB of model weights to /data/hf.
GENRE_MODEL_ENABLED=false
# GENRE_MODEL=laion/clap-htsat-unfused
# Seconds of audio analysed per track (from the start).
# GENRE_SEGMENT_SECONDS=20
# Comma-separated candidate labels the audio is matched against. Leave unset for
# the Bollywood-focused defaults (film song, ghazal, qawwali, bhangra, …).
# GENRE_LABELS=Bollywood film song,romantic Hindi ballad,bhangra,ghazal,qawwali,pop,rock
# Let the LLM expand the CLAP label list (tailored to your moods + library) once
# at the start of indexing. Uses GENRE_LABELS as seeds; capped at GENRE_LABELS_MAX.
# GENRE_LABELS_FROM_LLM=false
# GENRE_LABELS_MAX=30

# ─── App ─────────────────────────────────────────────────────────────────────
DB_PATH=/data/moodradio.db
PORT=8080
# Logging verbosity: DEBUG, INFO (default), WARNING, ERROR.
# Set DEBUG to trace every Navidrome/LLM HTTP request.
LOG_LEVEL=INFO

# ─── Deployment paths (host locations, used by docker-compose bind mounts) ────
# APP_DIR: folder on your server holding the app code (the `app/` directory).
#   Mounted into the container, so you can update code by editing files here and
#   restarting — no image rebuild needed for Python/HTML/CSS/JS changes.
# APP_DIR=/srv/mood-radio/app
# DATA_DIR: where the SQLite index (moodradio.db) is saved on your server.
# DATA_DIR=/srv/mood-radio/data
# MODEL_DIR: where CLAP model weights are cached (leave unset to use a Docker
#   named volume; set a path to keep the ~1.7GB download in a known folder).
# MODEL_DIR=/srv/mood-radio/models
# RELOAD: set to 1 to auto-reload the app on code edits (pairs with APP_DIR).
# RELOAD=1
