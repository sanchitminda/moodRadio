# Sample environment file for Mood Radio — copy to .env and fill in real values.
#   cp .env.sample .env

# ─── Navidrome (Subsonic API) ────────────────────────────────────────────────
NAVIDROME_URL=http://192.168.1.10:4533
NAVIDROME_USER=your_username
NAVIDROME_PASS=your_password

# ─── Local LLM (OpenAI-compatible /v1/chat/completions) ──────────────────────
# Ollama:    http://192.168.1.20:11434   (LLM_MODEL e.g. llama3.2)
# LM Studio: http://192.168.1.20:1234     (LLM_MODEL = the id shown in LM Studio)
LLM_BASE_URL=http://192.168.1.20:1234
LLM_MODEL=your-loaded-model-name
LLM_API_KEY=not-needed
# JSON enforcement: json_schema (LM Studio), json_object (Ollama), or text.
LLM_JSON_MODE=json_schema

# ─── Moods ───────────────────────────────────────────────────────────────────
# Single source of truth for prompt, DB, API and UI. Edit this list to add or
# remove moods (slug:Label,slug2:Label2), then restart and re-index.
MOODS=happy:Happy,sad:Sad,romantic:Romantic,driving:Driving,long_drive_slow:Long Drive · Slow,party:Party,workout:Workout,chill:Chill,focus:Focus,nostalgic:Nostalgic,devotional:Devotional

# ─── Indexing / enrichment ───────────────────────────────────────────────────
INDEX_BATCH_SIZE=8
LYRICS_USER_AGENT=mood-radio/1.0 (https://github.com/you/mood-radio)

# ─── Genre prediction (CLAP zero-shot audio classification) ───────────────────
# Needs the image built with INSTALL_GENRE=true (docker-compose sets that).
GENRE_MODEL_ENABLED=true
GENRE_MODEL=laion/clap-htsat-unfused
GENRE_SEGMENT_SECONDS=20
# Candidate labels CLAP matches the audio against (comma-separated).
GENRE_LABELS=Bollywood film song,romantic Hindi ballad,Bollywood dance number,item number,retro classic Bollywood,bhangra,Punjabi pop,ghazal,qawwali,sufi music,Indian classical,devotional bhajan,Hindi hip hop / rap,Hindi rock,pop,rock,electronic dance music
# Let the LLM expand the label list above once at index start (seeds = GENRE_LABELS).
GENRE_LABELS_FROM_LLM=false
GENRE_LABELS_MAX=30

# ─── App ─────────────────────────────────────────────────────────────────────
DB_PATH=/data/moodradio.db
PORT=8080
LOG_LEVEL=INFO

# ─── Deployment paths (host locations for docker-compose bind mounts) ─────────
# Point these at folders on your server to edit code without rebuilding and to
# keep the DB at a path you control. Leave unset for the ./app, ./data defaults.
# APP_DIR=/srv/mood-radio/app
# DATA_DIR=/srv/mood-radio/data
# MODEL_DIR=/srv/mood-radio/models
# RELOAD=1
